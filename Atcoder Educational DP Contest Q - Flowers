#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 2e5 + 3;
int n, h[maxn];
int a[maxn];
pii BIT[maxn];

pii ma(pii x, pii y){
    return (x.se > y.se ? x : y);
}

void upd(int idx, pii val){
    while(idx <= n){
        BIT[idx] = ma(BIT[idx], val);
        idx += idx & -idx;
    }
}

pii get(int idx){
    pii res = BIT[0];
    while(idx){
        res = ma(res, BIT[idx]);
        idx -= idx & -idx;
    }

    return res;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> h[i];
    for(int i = 1; i <= n; i++) cin >> a[i];

    for(int i = 1; i <= n; i++){
        pii res = get(h[i] - 1);

        res.fi++;
        res.se += a[i];

        upd(h[i], res);
    }

    pii ans = get(n);

    cout << ans.se;

    return 0;
}
