#include<bits/stdc++.h>
using namespace std;

const int N = (int) 1e6 + 4;

string s;
int nSize;
int cnt[2];
long long ans = 0;

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    #define TASK "CAU4"
    if(fopen(TASK".inp", "r")){
        freopen(TASK".inp", "r", stdin);
        freopen(TASK".out", "w", stdout);
//        freopen(TASK".ans", "w", stdout);
    }

    cin >> s; nSize = s.size();
    s = ' ' + s;

    for(int i = nSize; i > 0; i--){
        if(s[i] == 'a' || s[i] == 'e' || s[i] == 'i' || s[i] == 'o' || s[i] == 'u'){
            ans += cnt[1];
            cnt[0]++;
        }
        else{
            ans += cnt[0];
            cnt[1]++;
        }
    }

    cout << ans;

    return 0;
}
