/// code

void solve(){
    int ma = 0;
    int n, k, s = 0;
    cin >> n >> k;
    for(int i = 1; i <= n; i++){
        int ai; cin >> ai;
        ma = max(ai, ma);
        s += ai;
    }

    if((s + k) % n) cout << "NO" << el;
    else{
        if(ma <= (s + k)/n) cout << "YES" << el;
        else cout << "NO" << el;
    }
}

