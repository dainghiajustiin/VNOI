#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 3e4 + 5;
pii dp[maxn];
/// fi la noi voi cai truoc
/// se la noi voi cai sau

int n, a[maxn];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i < n; i++) cin >> a[i];
    a[n] = inf;

    dp[1].fi = inf;
    dp[1].se = a[1];
    for(int i = 2; i <= n; i++){
        dp[i].fi = dp[i - 1].se;
        dp[i].se = min(dp[i - 1].fi, dp[i - 1].se) + a[i];
    }

    int ans = min(dp[n].fi, dp[n].se);

    cout << ans;

    return 0;
}
