str Plus(str a,str b){
    str ans;
    int Memory=0;
    for(int i=0;i<b.size();i++){
        int Sum=(a[a.size()-1-i]-'0') + (b[b.size()-1-i]-'0') +Memory;
        Memory=Sum/10;
        ans=(char)(Sum%10+48) + ans;
    }
    for(int i=b.size();i<a.size();i++){
        int Sum=(a[a.size()-1-i]-'0') +Memory;
        Memory=Sum/10;
        ans=(char)(Sum%10+48) + ans;
    }
    if(Memory) ans= '1' + ans;
    return ans;
}

int main(){
