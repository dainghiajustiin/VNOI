//    freopen(task".out", "w", stdout);

    int n; cin >> n;
    vector<int> v(n, 0);
    vector<int> res(n, 1);
    int ans = 0;

    for(int i = 0; i < n; i++) cin >> v[i];
    for(int i = 0; i < n; i++){
        for(int j = 0; j < i; j++){
            if(v[i] > v[j]){
                res[i] = max(res[i], res[j] + 1);
            }
        }
        ans = max(ans, res[i]);
    }

    cout << ans;

    return 0;
}
