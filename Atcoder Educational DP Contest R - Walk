const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using ull = unsigned long long;

/// code
int n;
ll k;
struct matrix{
    ll x[50][50];
};

matrix operator * (matrix& a, matrix& b){
    matrix c;

    memset(c.x, 0, sizeof c.x);

    for(int i = 0; i < n; i++){
        for(int j = 0; j < n; j++){
            for(int k = 0; k < n; k++){
                c.x[i][j] = (c.x[i][j] + a.x[i][k]*b.x[k][j]) % MOD;
            }
        }
    }

    return c;
}

matrix bin_pow(matrix& a, ll N){
    if(N == 0){
        matrix I;

        memset(I.x, 0, sizeof I.x);

        for(int i = 0; i < n; i++) I.x[i][i] = 1;

        return I;
    }

    matrix res = bin_pow(a, N >> 1);
    res = (res * res);
    if(N & 1) res = (res * a);
    return res;
}

matrix a;

