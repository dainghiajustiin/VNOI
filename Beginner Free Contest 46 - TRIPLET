    cin >> n >> s;

    for(int c = n; c >= 0; c--){
        for(int b = c; b >= 0; b--){
            int a = s - b - c;
            if(0 <= a && a <= b){
                if(c == a) ans++;
                else if(a == b || b == c) ans += 3;
                else ans += 6;
            }
        }
    }

    cout << ans;

    return 0;
}
