signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    char s;
    priority_queue<int> pq;

    while(cin >> s){
        if(s == '-'){
            if(pq.empty()) continue;

            int ma = pq.top();

            while(!pq.empty() && pq.top() == ma) pq.pop();
        }
        else{
            int n; cin >> n;

            if(pq.size() < 15000) pq.push(n);
        }
    }

    vector<int> vec;
    
    while(!pq.empty()){
        int ma = pq.top();
        vec.pb(ma);
        
        while(!pq.empty() && pq.top() == ma) pq.pop();
    }
    
    cout << vec.size() << el;
    for(int it:vec) cout << it << el;

    return 0;
}
