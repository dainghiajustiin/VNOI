#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 5e5 + 3;
vector<pair<ll, ll>> vec;
int n, q;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> q;
    for(int i = 1; i <= n; i++){
        ll a, b, w;
        cin >> a >> b >> w;

        vec.pb(Mp(a*a + b*b, w));
    }

    sort(all(vec));

    for(int i = 1; i < n; i++) vec[i].se += vec[i - 1].se;

    while(q--){
        ll r; cin >> r;
        int it = upper_bound(all(vec), Mp(r*r + 1, -inf)) - vec.begin() - 1;

        if(it < 0) cout << 0 << el;
        else cout << vec[it].se << el;
    }

    return 0;
}
