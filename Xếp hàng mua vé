#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 6e4 + 3;
int n;
int a[maxn], p[maxn];
pii dp[maxn];
/// dp[i].fi = tgian min khi xet den ng thu i va ho tu mua
/// dp[i].se = tgian min khi xet den ng thu i va nho ng trc mua

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];
    for(int i = 2; i <= n; i++) cin >> p[i];

    dp[1].fi = a[1]; dp[1].se = inf;
    for(int i = 2; i <= n; i++){
        dp[i].fi = min(dp[i - 1].fi, dp[i - 1].se) + a[i];
        dp[i].se = dp[i - 1].fi + p[i] - a[i - 1];
    }

    int ans = min(dp[n].fi, dp[n].se);
    cout << ans;

    return 0;
}
