#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
int n, m;
int dp[102][102];
int ans = -inf;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> m >> n;

    memset(dp, -0x3f, sizeof dp);

    for(int i = 1; i <= m; i++){
        for(int j = 1; j <= n; j++) cin >> dp[i][j];
    }

    for(int j = 2; j <= n; j++){
        for(int i = 1; i <= m; i++){
            dp[i][j] += max({dp[i][j - 1], dp[i - 1][j - 1], dp[i + 1][j - 1]});
            if(j == n) ans = max(ans, dp[i][j]);
        }
    }

    cout << ans;

    return 0;
}
