#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int n, m, p;

pii f[maxn];

bool check(int mid){
    int cnt = 0;
    for(int i = 1; i <= n; i++){
        if( f[i].fi + mid - 1 >= f[i].se ) cnt++;
    }

    return (cnt >= m);
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> m >> p;
    for(int i = 1; i <= n; i++){
        cin >> f[i].fi >> f[i].se;
    }

    int l = 1, r = MOD;
    int ans;

    while(l <= r){
        int mid = l + r >> 1;

        if(check(mid)){
            ans = mid;
            r = mid - 1;
        }
        else l = mid + 1;
    }

    cout << ans;

    return 0;
}
