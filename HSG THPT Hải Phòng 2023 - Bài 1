#include<bits/stdc++.h>
using namespace std;

int cnt(int N){
    int res = 0;
    for(int i = 1; i*i <= N; i++){
        if(N%i == 0){
            if(i*i == N) res++;
            else res += 2;
        }
    }

    return res;
}

