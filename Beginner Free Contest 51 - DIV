/// code
const int maxn = (int) 1e6 + 503;
int n;
int a[maxn];

int lp[maxn];
vector<int> pr;

void linear(){
    for(int i = 2; i < maxn; i++){
        if(lp[i] == 0){
            lp[i] = i;
            pr.pb(i);
        }

        for(int j = 0; pr[j] * i < maxn; j++){
            lp[pr[j]*i] = pr[j];
            if(lp[i] == pr[j]) break;
        }
    }
}

namespace sub4{
    bool ok(){
        for(int i = 2; i <= n; i++){
            if(a[i] != a[i - 1] + 1) return 0;
        }
        return 1;
    }

    int res[maxn];
    int be;

    void solve(){
        for(int i = 1; i <= n; i++) res[i] = 1;
        be = a[1];

        for(int it:pr){
            int r = be % it;
            if(r == 0) r = it;

            for(int i = 1 + it - r; i <= n; i += it){
                int s = 1;
                while( a[i] % it == 0 ){
                    s *= it;
                    a[i] /= it;
                }
                res[i] = res[i] * (s * it - 1) / (it - 1);
            }
        }

        for(int i = 1; i <= n; i++){
            if(a[i] != 1){
                res[i] *= (a[i] + 1);
            }
            cout << res[i] << ' ';
        }
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];
    linear();

    if(sub4::ok()) return sub4::solve(), 0;

    for(int i = 1; i <= n; i++){
        int res = 1;
        int s = lp[a[i]];

        while(a[i] != 1){
            if(lp[a[i]] == lp[a[i]/lp[a[i]]]) s *= lp[a[i]];
            else{
                res = res * (s * lp[a[i]] - 1) / (lp[a[i]] - 1);
                s = lp[a[i]/lp[a[i]]];
            }
            a[i] /= lp[a[i]];
        }

        cout << res << ' ';
    }

    return 0;
}
