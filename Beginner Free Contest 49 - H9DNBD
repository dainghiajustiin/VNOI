#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int a[maxn];
int n, k;
int ans = 0, cnt = 0;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> k;
    for(int i = 1; i <= n; i++) cin >> a[i];
    sort(a + 1, a + 1 + n);

    for(int i = 1; i <= n; i++){
        int j = i;
        while(a[i + 1] == a[j]) i++;

        if(i - j + 1 >= k){
            cnt++;
            ans += a[j];
        }
    }

    cout << cnt << ' ' << ans;

    return 0;
}
