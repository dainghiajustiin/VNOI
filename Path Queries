/// code
const int maxn = (int) 2e5 + 3;
int timeIn[maxn];
int timeOut[maxn];
int a[maxn];
ll IT[maxn << 2];
ll dp[maxn];
vector<int> adj[maxn];
int numNode, numQuery;
int timeDfs = 0;

void dfs(int u, int p){
    timeIn[u] = ++timeDfs;

    for(int v:adj[u]){
        if(v == p) continue;

        dp[v] = dp[u] + a[v];
        dfs(v, u);
    }

    timeOut[u] = timeDfs;
}

void down(int id){
    ll k = IT[id]; IT[id] = 0;

    IT[id << 1] += k;
    IT[id << 1 | 1] += k;
}

void upd(int id, int l, int r, int u, int v, int val){
    if(v < l || r < u) return;
    if(u <= l && r <= v){
        IT[id] += val;
        return;
    }

    down(id);
    int m = l + r >> 1;

    upd(id << 1, l, m, u, v, val);
    upd(id << 1 | 1, m + 1, r, u, v, val);
}

ll get(int id, int l, int r, int pos){
    if(pos < l || r < pos) return 0;
    if(l == r) return IT[id];

    down(id);
    int m = l + r >> 1;

    ll it1 = get(id << 1, l, m, pos);
    ll it2 = get(id << 1 | 1, m + 1, r, pos);

    return it1 + it2;
}

