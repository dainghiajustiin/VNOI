    cin >> n >> q;
    for(int i = 1; i <= n; i++) cin >> a[i];

    for(int i = 1; i < n; i++){
        int u, v; cin >> u >> v;
        vec[u].pb(v);
        vec[v].pb(u);
    }

    dfs(root, 0);

    for(int i = 1; i <= n; i++){
        upd(st[i], a[i]);
    }

    while(q--){
        int type; cin >> type;
        if(type == 1){
            int i, x; cin >> i >> x;

            upd(st[i], x - a[i]);

            a[i] = x;
        }
        else{
            int u; cin >> u;
            ll ans = get(en[u]) - get(st[u] - 1);
            cout << ans << el;
        }
    }

    return 0;
}   /// Justiin
