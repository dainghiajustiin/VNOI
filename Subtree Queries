#include<bits/stdc++.h>
using namespace std;

#define fi first
#define se second
#define ll long long
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()
#define Mp make_pair
using pii = pair<int,int>;
const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using ull = unsigned long long;

/// code
const int maxn = (int) 2e5 + 3;
int n, q, m = 0, root = 1;
int h[maxn];
int st[maxn];
int en[maxn];
int tour[maxn];
vector<int> vec[maxn];

int a[maxn];
ll BIT[maxn];

void dfs(int u, int p){
    tour[++m] = u;
    st[u] = m;

    for(int v:vec[u]){
        if(v == p) continue;
        dfs(v, u);
    }

    en[u] = m;
}

void upd(int x, int val){
    while(x <= n){
        BIT[x] += val;
        x += x&-x;
    }
}

ll get(int x){
    ll res = 0;
    while(x){
        res += BIT[x];
        x -= x&-x;
    }

    return res;
}

