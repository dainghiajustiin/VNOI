#include<bits/stdc++.h>
using namespace std;

const int MAXN = (int) 1e5 + 7;

int n, k, a[MAXN];
long long ans = 0, s = 0;
map<long long, int> mp;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> n >> k;
    mp[0] = 1;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        a[i] -= k;
        s += a[i];
        ans += mp[s];
        mp[s] += 1;
    }

    cout << ans;

    return 0;
}
