#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
pair<ll, ll> f[46];

void solve(){
    int n, k;
    cin >> n >> k;
    ll res = 0;

    while(n > 1){
        if(k > f[n - 2].se) res += f[n - 2].fi, k -= f[n - 2].se, n--;
        else n -= 2;
    }

    res += f[n].fi;

    cout << res << el;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    f[0].fi = 1; f[0].se = 1;
    f[1].fi = 0; f[1].se = 1;
    for(int i = 2; i <= 45; i++){
        f[i].fi = f[i - 1].fi + f[i - 2].fi;
        f[i].se = f[i - 1].se + f[i - 2].se;
    }

    int t; cin >> t;
    while(t--) solve();

    return 0;
}
