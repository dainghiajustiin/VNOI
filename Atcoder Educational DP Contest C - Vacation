    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i] >> b[i] >> c[i];
    for(int i = 2; i <= n; i++){
        a[i] += max(b[i - 1], c[i - 1]);
        b[i] += max(a[i - 1], c[i - 1]);
        c[i] += max(a[i - 1], b[i - 1]);
    }

    cout << max({a[n], b[n], c[n]});

    return 0;
}
