#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int r[maxn];
int a[maxn];
vector<int> vec[maxn];
map<int,int> mp[maxn];
int n, q;

void Union(int u, int v){
    int ru = r[u];
    int rv = r[v];
    if(ru == rv) return;

    if(vec[ru].size() < vec[rv].size()) swap(ru, rv);

    mp[rv].clear();

    for(int it:vec[rv]){
        vec[ru].pb(it);
        mp[ru][a[it]]++;
        r[it] = ru;
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> q;
    for(int i = 1; i <= n; i++){
        cin >> a[i];

        r[i] = i;
        vec[i].pb(i);
        mp[i][a[i]]++;
    }

    while(q--){
        int type, u, v;
        cin >> type >> u >> v;

        if(type == 1){
            Union(u, v);
        }
        else{
            cout << mp[r[u]][v] << el;
        }
    }

    return 0;
}
