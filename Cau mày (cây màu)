/// code
const int maxn = (int) 2e5 + 3;

vector<int> adj[maxn];
set<int> node[maxn];
int color[maxn];
int ans[maxn];
int numNode;

void dfs(int u, int p){
    for(int v:adj[u]){
        if(v == p) continue;

        dfs(v, u);

        if(node[v].size() > node[u].size()) swap(node[v], node[u]);

        for(int x:node[v]) node[u].insert(x);
    }

    ans[u] = node[u].size();
}

