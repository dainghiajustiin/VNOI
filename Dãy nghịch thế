/// code
const int maxn = (int) 6e4 + 5;
int n;
int a[maxn];
int seg[maxn << 2];
int ans = 0;

void upd(int id, int l, int r, int pos){
    if(pos < l || r < pos) return;
    if(l == r){
        seg[id]++;
        return;
    }

    int m = l + r >> 1;

    upd(id << 1, l, m, pos);
    upd(id << 1 | 1, m + 1, r, pos);

    seg[id] = seg[id << 1] + seg[id << 1 | 1];
}
int get(int id, int l, int r, int pos){
    if(pos < l) return 0;
    if(pos >= r) return seg[id];

    int m = l + r >> 1;

    int it1 = get(id << 1, l, m, pos);
    int it2 = get(id << 1 | 1, m + 1, r, pos);

    return it1 + it2;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
