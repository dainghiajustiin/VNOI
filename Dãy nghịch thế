//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];

    for(int i = n; i; i--){
        ans += get(1, 1, 60000, a[i] - 1);
        upd(1, 1, 60000, a[i]);
    }

    cout << ans;

    return 0;
}
