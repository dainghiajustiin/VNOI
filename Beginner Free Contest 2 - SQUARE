    int t; cin >> t;
    while(t--){
        int hi, ha, wi, wa;
        cin >> hi >> ha >> wi >> wa;
        if(wi <= ha && ha <= wa){
            cout << ha << el;
            continue;
        }
        if(hi <= wa && wa <= ha){
            cout << wa << el;
            continue;
        }

        int res = 1;
        for(int i = 1; ; i++){
            int x = ha/i;
            if(x*i < hi) continue;
            if(x == 1) break;

            if(wa/x*x >= wi){
                res = x;
                break;
            }
        }

        for(int i = 1; ; i++){
            int x = wa/i;
            if(x*i < wi) continue;
            if(x <= res) break;

            if(ha/x*x >= hi){
                res = x;
                break;
            }
        }
        cout << res << el;
    }

    return 0;
