#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int n, s;

int a[maxn];
int dd[1001];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> s;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        if(a[i] == s){
            cout << 1;
            return 0;
        }
    }

    int ans = inf;

    for(int i = 1; i <= n; i++){
        for(int j = s; j > a[i]; j--){
            if(dd[j - a[i]]){
                dd[j] = max(dd[j], dd[j - a[i]]);
                if(j == s) ans = min(ans, i - dd[j] + 1);
            }
        }
        dd[a[i]] = i;
    }

    if(ans == inf) cout << -1;
    else cout << ans;

    return 0;
}
