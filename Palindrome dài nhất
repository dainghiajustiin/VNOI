#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code

string s;
const int base = 137, mm = MOD * MOD, maxn = (int) 5e4 + 3;
int hl[maxn], hr[maxn];
int p[maxn];
int n;

bool check(int len){
    for(int i = 1; i + len - 1 <= n; i++){
        if((hl[i + len - 1] - hl[i - 1] * p[len] + mm) % MOD
           == (hr[i] - hr[i + len] * p[len] + mm ) % MOD) return 1;
    }

    return 0;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    cin >> s;
    s = ' ' + s;

    p[0] = 1;
    for(int i = 1; i <= n; i++) p[i] = p[i - 1] * base % MOD;

    hl[0] = 0;
    for(int i = 1; i <= n; i++) hl[i] = (hl[i - 1] * base + s[i]) % MOD;

    hr[n + 1] = 0;
    for(int i = n; i; i--) hr[i] = (hr[i + 1] * base + s[i]) % MOD;

    int l = 0, r = (n - 1)/2, res;

    while(l <= r){
        int m = l + r >> 1;
        if(check(2*m + 1)){
            res = 2*m + 1;
            l = m + 1;
        }
        else r = m - 1;
    }

    l = 1, r = n/2;
    while(l <= r){
        int m = l + r >> 1;
        if(check(2*m)){
            res = max(res, 2*m);
            l = m + 1;
        }
        else r = m - 1;
    }

    cout << res;

    return 0;
}
