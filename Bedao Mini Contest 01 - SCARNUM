int to_int(string s){
    int res = 0;
    for(char c:s) res = res * 10 + c - '0';
    return res;
}
vector<int> vec;

void backtrack(string s){
    if(s.size() > 6) return;
    vec.pb(to_int(s));

    backtrack(s + '2');
    backtrack(s + '5');
}

