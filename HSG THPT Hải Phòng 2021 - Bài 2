#include<bits/stdc++.h>
using namespace std;

#define ll long long

const int N = (int) 1e6 + 3;
mt19937_64 rd(time(0));
ll rand(ll L, ll R){
    return L + rd()%(R - L + 1);
}

int nSize, nQuery;
int a[N];

int lp[N*10];
vector<int> pr;
int dp[N];

void linear(){
    int Lim = (int) 1e7 + 10;
    for(int i = 2; i <= Lim; i++){
        if(lp[i] == 0){
            lp[i] = i;
            pr.push_back(i);
        }

        for(int j = 0; pr[j]*i <= Lim; j++){
            lp[pr[j]*i] = lp[i];
            if(pr[j] == lp[i]) break;
        }
    }
}

namespace Sub2{
    bool Check(){
        for(int i = 1; i <= nSize; i++){
            if(a[i] > (int) 1e6) return 1;
        }
        return 0;
    }

    long long binPow(int A, int B, int mod){
        if(B == 0) return 1;
        long long res = binPow(A, B >> 1, mod) % mod;
        res = res*res % mod;
        if(B & 1) res = res*A % mod;

        return res;
    }

    bool Fermat_check(int N){
        int C = 5;

        while(C--){
            int A = rand(1, N - 3) + 2;
            if(binPow(A, N - 1, N) != 1) return 0;
        }

        return 1;
    }

    bool isPrePrime(int N){
        bool ok = 0;
        for(int i = 1; i <= 9 && !ok; i += 2){
            if(i == 5) continue;
            if(Fermat_check(N*10 + i)) ok = 1;
        }
        if(!ok) return 0;

        while(N > 0){
            if(N > (int) 1e7){
                if(!Fermat_check(N)) return 0;
            }
            else{
                if(lp[N] != N) return 0;
            }
            N /= 10;
        }

        return 1;
    }

    void Solve(){
        linear();

        for(int i = 1; i <= nSize; i++) dp[i] = dp[i - 1] + (isPrePrime(a[i]));

        cin >> nQuery;
        for(int i = 1; i <= nQuery; i++){
            int l, r; cin >> l >> r;
            cout << dp[r] - dp[l - 1] << '\n';
        }
    }
}

namespace Sub3{
