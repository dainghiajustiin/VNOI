    }

    bool isPrePrime(int N){
        bool ok = 0;
        for(int i = 1; i <= 9 && !ok; i++){
            if(i == 5) continue;
            if(lp[N*10 + i] == N*10 + i) ok = 1;
        }

        if(!ok) return 0;

        while(N > 0){
            if(lp[N] != N) return 0;
            N /= 10;
        }

        return 1;
    }

    void Solve(){
        linear();

        for(int i = 1; i <= nSize; i++) dp[i] = dp[i - 1] + isPrePrime(a[i]);

        cin >> nQuery;
        for(int i = 1; i <= nQuery; i++){
            int l, r; cin >> l >> r;
            cout << dp[r] - dp[l - 1] << '\n';
        }
