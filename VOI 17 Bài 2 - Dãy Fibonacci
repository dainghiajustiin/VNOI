#include<bits/stdc++.h>
using namespace std;

const int maxn = (int) 1e6 + 7;

long long nTest, n[15], i[15], k[15];
int mod = 1;
int f[maxn];
int pre[maxn];
int pos[maxn];

struct matrix{
    int x[2][2];

    matrix(){
        memset(x, 0, sizeof x);
    }
};

matrix mul(matrix A, matrix B){
    for(int a = 0; a < 2; a++){
        for(int b = 0; b < 2; b++) A.x[a][b] %= mod, B.x[a][b] %= mod;
    }

    matrix C;
    for(int a = 0; a < 2; a++){
        for(int b = 0; b < 2; b++){
            for(int c = 0; c < 2; c++) C.x[a][b] = (C.x[a][b] + 1ll * A.x[a][c] * B.x[c][b]) % mod;
        }
    }
    return C;
}

int pw(long long p){
    if(p == 0 || p == 1) return p;

    matrix A;
    A.x[0][0] = 1, A.x[0][1] = 1;
    A.x[1][0] = 1, A.x[1][1] = 0;

    matrix res;
    res.x[0][0] = 1, res.x[0][1] = 0;
    res.x[1][0] = 0, res.x[1][1] = 1;

    p--;
    while(p > 0){
        if(p & 1) res = mul(res, A);
        A = mul(A, A);
        p >>= 1;
    }

    return res.x[0][0];
}

namespace subfull{
    bool check(){
        return 1;
    }

    void solve(){
        for(int j = 1; j <= nTest; j++){
            mod = k[j];
            f[1] = pw(i[j]);
            f[2] = pw(i[j] + 1);
            for(int loop = 3; loop <= n[j]; loop++) f[loop] = (f[loop-1] + f[loop-2]) % mod;
            memset(pre, 0, sizeof pre);
            memset(pos, 0, sizeof pos);
            for(int loop = 1; loop <= n[j]; loop++){
                pre[loop] = ((pre[loop-1] + f[loop])%mod + mod)%mod;
                if(pre[loop] == 0 || pos[pre[loop]] > 0){
                    int ans = loop - pos[pre[loop]];
                    cout << ans << ' ';
                    for(int p = pos[pre[loop]] + 1; p <= loop; p++) cout << p + i[j] - 1 << ' ';
                    cout << '\n';
                    break;
                }
                pos[pre[loop]] = loop;
            }
        }
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> nTest;
    for(int j = 1; j <= nTest; j++){
        cin >> n[j] >> i[j] >> k[j];
    }

    if(subfull::check()) return subfull::solve(), 0;

    return 0;
}

