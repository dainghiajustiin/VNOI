#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()
#define ld long double

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;
using pld = pair<ld, ld>;

/// code
const ld pi = acos(-1);
struct point{
    ll x, y;
} base;

ll calc(point A, point B, point C){
    ll res = (C.x - A.x)*(B.y - A.y) - (B.x - A.x)*(C.y - A.y);
    if(res < 0) res = -res;
    return res;
}

ld ans;

void solve(){
    ld c1 = sqrt(base.x*base.x + base.y*base.y);
    ld c2 = 10;

    point base_, O;
    base_.x = 10;
    base_.y = 0;
    O.x = 0;
    O.y = 0;

    ld S = 1.0*calc(O, base, base_)/2;

    if(base.x > 0){
        ld L = 0, R = pi/2;

        int C = 100;
        while(C--){
            ld M = 1.0*(L + R)/2;
            ld S_ = c1*c2*sin(M)/2;

            if(S >= S_){
                ans = M;
                L = M;
            }
            else R = M;
        }
    }
    else{
        ld L = pi/2, R = pi;

        int C = 100;
        while(C--){
            ld M = 1.0*(L + R)/2;
            ld S_ = c1*c2*sin(M)/2;

            if(S >= S_){
                ans = M;
                R = M;
            }
            else L = M;
        }
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> base.x >> base.y;

    if(base.y < 0){
        base.y = -base.y;
        solve();
        ans = 2*pi - ans;
    }
    else solve();

    cout << setprecision(9) << fixed << ans;

    return 0;
}
