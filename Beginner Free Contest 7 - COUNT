/// code
const int maxn = (int) 5e5 + 3;
int n, a[maxn];
ll s = 0, ans = 0;
int cnt = 0;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i], s += a[i];

    if(s % 3 != 0){
        cout << 0;
        return 0;
    }

    ll sum = 0;
    for(int i = 1; i <= n; i++){
        sum += a[i];

        if(sum == s/3*2 && i != n){
            ans += cnt;
        }

        if(sum == s/3){
            cnt++;
        }
    }

    cout << ans;

    return 0;
}
