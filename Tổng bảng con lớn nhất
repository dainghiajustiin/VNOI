#include<bits/stdc++.h>
using namespace std;

const int maxn = 505;

long long pre[maxn][maxn];
int a[maxn][maxn], n, m;

long long get(int u, int v, int p, int q){
    return pre[p][q] + pre[u-1][v-1]
          -pre[p][v-1] - pre[u-1][q];
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> n >> m;
    for(int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++){
            cin >> a[i][j];
            pre[i][j] = pre[i][j-1] + a[i][j];
        }
    }

    for(int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++){
            pre[i][j] += pre[i-1][j];
        }
    }

    long long ans = (long long) -1e18;

    for(int i = 1; i <= n; i++){
        for(int j = i; j <= n; j++){
            int pos = 1;
            for(int k = 1; k <= m; k++){
                ans = max(ans, get(i, pos, j, k));
                if(get(i, pos, j, k) < 0) pos = k + 1;
            }
        }
    }

    cout << ans;

    return 0;
}
