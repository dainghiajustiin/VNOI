//Begin

int n;
int a[29];
str s;

signed main(){
	ios_base::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);

	cin >> n;
	cin >> s;

	for(int i = 0; i < 26; i++) cin >> a[i];

	str ans;
	int i = 0;

	for(auto x:s){
        if( x != '?' ){
            a[1ll * (x - 'a')]--;
            if(a[1ll * (x - 'a')] < 0) return cout << -1, 0;
        }
	}

	for(auto x:s){
        if( x != '?' ){
            ans += x;
        }
        else{
            while(!a[i] && i < 26) i++;

            if(i >= 26) return cout << -1, 0;
            ans += char(i + 'a');
            a[i]--;
            if(a[i] < 0) return cout << -1, 0;
        }
	}


	for(int ii = 0; ii < 26; ii++) if( a[ii] != 0 ) return cout << -1, 0;

	cout << ans;


    return 0;
}

