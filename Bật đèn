//    }

    cin >> nSize >> nQuery;

    for(int i = 1; i <= nQuery; i++){
        int type, l, r; cin >> type >> l >> r;

        if(type == 0){
            upd(1, 1, nSize, l, r);
        }
        else{
            int ans = get(1, 1, nSize, l ,r);
            cout << ans << '\n';
        }
    }

    return 0;
}
