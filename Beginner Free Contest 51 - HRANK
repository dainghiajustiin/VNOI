#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e3 + 7;
int n, q, a[maxn];
int f[maxn];

int BIT[maxn];
void upd(int idx, int val){
    while(idx <= n){
        BIT[idx] += val;
        idx += idx & -idx;
    }
}
int get(int idx){
    int res = 0;
    while(idx){
        res += BIT[idx];
        idx -= idx & -idx;
    }
    return res;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> q;
    a[1] = 0;
    for(int i = 2; i <= n; i++) cin >> a[i];

    for(int i = 1; i <= n; i++){
        upd(i, 1);
    }

    for(int i = n; i > 0; i--){
        int l = 1, r = n;
        int pivot;

        while(l <= r){
            int m = l + r >> 1;
            int it = get(m); /// so luong khi xet den m

            if(it >= a[i] + 1){
                pivot = m;
                r = m - 1;
            }
            else l = m + 1;
        }

        upd(pivot, -1);
        f[i] = pivot;
    }

    for(int i = 1; i <= q; i++){
        int x; cin >> x;
        cout << f[x] << el;
    }

    return 0;
}
