#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
int a[16][16];
int dp[1 << 16];
int diem[1 << 16];
int n;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 0; i < n; i++){
        for(int j = 0; j < n; j++){
            cin >> a[i][j];
        }
    }

    for(int mask = 0; mask < (1 << 16); mask++){
        for(int i = 0; i < n; i++){
            if((mask >> i) & 1){
                for(int j = i + 1; j < n; j++){
                    if((mask >> j) & 1){
                        diem[mask] += a[i][j];
                    }
                }
            }
        }
    }

    for(int mask = 0; mask < (1 << 16); mask++){
        for(int i = mask; i; i = (i - 1) & mask){
            dp[mask] = max(dp[mask], dp[mask ^ i] + diem[i]);
        }
    }

    cout << dp[(1 << n) - 1];

    return 0;
}
