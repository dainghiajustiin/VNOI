    }

    cin >> n >> m;

    for(int i = 1; i <= m; i++){
        int u, v; cin >> u >> v;
        vec[u].pb(v);
    }

    for(int i = 1; i <= n; i++){
        if(num[i] == 0) tarjan(i);
    }

    cout << res;

    return 0;
}   /// Justiin
