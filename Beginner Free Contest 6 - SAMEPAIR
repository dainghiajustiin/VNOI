#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e6 + 3;
int lp[maxn];
vector<int> pr;

void linear(){
    for(int i = 2; i <= (int) 1e6 + 1; i++){
        if(lp[i] == 0){
            lp[i] = i;
            pr.pb(i);
        }

        for(int j = 0; pr[j] * i <= (int) 1e6 + 1; j++){
            lp[pr[j] * i] = pr[j];
            if(pr[j] == lp[i]) break;
        }
    }
}

int dem[maxn];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    linear();

    int l, r; cin >> l >> r;
    ll ans = 0;

    for(int i = l; i <= r; i++){
        int n = i;
        vector<int> get;
        int s = lp[n];

        while(n != 1){
            if(lp[n] != lp[n/lp[n]]){
                get.pb(s);
                s = lp[n/lp[n]];
            }

            n /= lp[n];
        }

        int V = 1;
        for(int j = 0; j < get.size(); j++) V *= get[j];

        ans += dem[V];
        dem[V]++;
    }

    cout << ans;

    return 0;
}
