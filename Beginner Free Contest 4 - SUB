#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int a[maxn];

void solve(){
    int n; cin >> n;
    int kq1 = -inf, kq2 = -inf;

    for(int i = 1; i <= n; i++){
        cin >> a[i];
        kq1 = max(kq1, a[i]);
    }

    if(kq1 < 0){
        cout << kq1 << ' ' << kq1 << el;
    }
    else{
        kq1 = kq2 = 0;
        for(int i = 1; i <= n; i++){
            if(a[i] > 0) kq1 += a[i];
            if(a[i - 1] > 0) a[i] += a[i - 1];
            kq2 = max(kq2, a[i]);
        }

        cout << kq1 << ' ' << kq2 << el;
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    int t; cin >> t;
    while(t--) solve();

    return 0;
}
