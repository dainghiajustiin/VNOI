#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
struct point{
    ll x, y;
} f[maxn];

int n;
ll s = 0;

ll calc(point A, point B, point C){
    ll res = (B.x - A.x) * (C.y - A.y) - (C.x - A.x) * (B.y - A.y);
    if(res < 0) res = -res;

    return res;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> f[i].x >> f[i].y;
    }

    point be = f[1];
    point tmp = f[2];
    point en;

    for(int i = 3; i <= n; i++){
        en = f[i];

        s += calc(be, tmp, en);

        tmp = f[i];
    }

    long double ans = 1.0 * s / 2;

    cout << setprecision(6) << fixed << ans;

    return 0;
}
