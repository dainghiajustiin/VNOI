#include<bits/stdc++.h>
using namespace std;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    int n, k;
    cin >> n >> k;
    int lo = 1, hi = n;
    while(lo <= hi){
        int mid = (lo + hi) >> 1;
        cout << mid << endl;
        string s;
        cin >> s;
        if(s == "HOLA") break;
        else if(s == "BIGGER") lo = mid + 1;
        else hi = mid - 1;
    }

    return 0;
}
