const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
int P(int a, int b){
    if(!b) return 1;
    int res = P(a, b >> 1) % MOD;
    res = res * res % MOD;
    if(b & 1) res = res * a % MOD;
    return res;
}

int solve(int n, int k){ /// tinh
    if(n < k) return 0;
    if(k == 0) return 1;
    if(k > n - k) return solve(n, n - k);

    int a = 1, b = 1;
    for(int i = 1; i <= k; i++){
        a = a * (n - i + 1) % MOD;
        b = b * i % MOD;
    }

    return a * P(b, MOD - 2) % MOD;
}

signed main(){
