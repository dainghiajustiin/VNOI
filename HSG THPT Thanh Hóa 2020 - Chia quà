#include<bits/stdc++.h>
using namespace std;

int gcd(int a, int b){
    if(b == 0) return a;
    return gcd(b, a%b);
}

int cnt(int N){
    int res = 0;
    for(int i = 1; i*i <= N; i++){
        if(N%i == 0){
            if(i*i == N) res++;
            else res += 2;
        }
    }

    return res;
}

