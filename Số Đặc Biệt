#include<bits/stdc++.h>
using namespace std;

const int maxn = (int) 1e6 + 7;
#define pii pair<int, int>
int n;
pii a[maxn];
vector<pii> v;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    #define file "SDB"
    if(fopen(file".inp", "r")){
        freopen(file".inp", "r", stdin);
        freopen(file".out", "w", stdout);
    }

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> a[i].first;
        a[i].second = i;
    }

    sort(a + 1, a + 1 + n);
    a[0].first = a[n+1].first = (int) 1e9 + 9;

    for(int i = 1; i <= n; i++){
        if(a[i].first != a[i-1].first && a[i].first != a[i+1].first) v.push_back({a[i].second, a[i].first});
    }

    sort(v.begin(), v.end());
    cout << v.size() << '\n';
    for(pii elm:v) cout << elm.second << '\n';

    return 0;
}

