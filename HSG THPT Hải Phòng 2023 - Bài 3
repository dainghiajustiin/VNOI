#include<bits/stdc++.h>
using namespace std;

const int N = (int) 1e7 + 3;

int lp[N];
vector<int> pr;
int dp[1007];
int nSize, nQuery;

void linear(){
    int Lim = (int) 1e7;
    for(int i = 2; i <= Lim; i++){
        if(lp[i] == 0){
            lp[i] = i;
            pr.push_back(i);
        }

        for(int j = 0; pr[j]*i <= Lim; j++){
            lp[pr[j]*i] = lp[i];
            if(pr[j] == lp[i]) break;
        }
    }
}

bool isPrime(int N){
    if(N < 2) return 0;
    return lp[N] == N;
}

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define TASK ""
