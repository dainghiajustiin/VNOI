#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e6 + 3;
int mod, n, q;
pii seg[maxn << 2];
int a[maxn];

void build(int id, int l, int r){
    if(l == r){
        seg[id].fi = a[l];
        return;
    }

    int m = l + r >> 1;
    build(id << 1, l, m);
    build(id << 1 | 1, m + 1, r);

    seg[id].fi = seg[id << 1].fi + seg[id << 1 | 1].fi;
}

void down(int id, int l, int r){
    int k = seg[id].se;
    seg[id].se = 0;
    int m = l + r >> 1;

    seg[id << 1].se += k;
    seg[id << 1].fi += (m - l + 1) * k;

    seg[id << 1 | 1].se += k;
    seg[id << 1 | 1].fi += (r - m) * k;
}

void upd(int id, int l, int r, int u, int v, int val){
    if(v < l || r < u) return;
    if(u <= l && r <= v){
        seg[id].se += val;
        seg[id].fi += (r - l + 1) * val;
        return;
    }

    int m = l + r >> 1;
    down(id, l, r);

    upd(id << 1, l, m, u, v, val);
    upd(id << 1 | 1, m + 1, r, u, v, val);

    seg[id].fi = seg[id << 1].fi + seg[id << 1 | 1].fi;
}

int get(int id, int l, int r, int u, int v){
    if(v < l || r < u) return 0;
    if(u <= l && r <= v) return seg[id].fi;

    int m = l + r >> 1;
    down(id, l, r);

    int it1 = get(id << 1, l, m, u, v);
    int it2 = get(id << 1 | 1, m + 1, r, u, v);

    return it1 + it2;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> mod >> n >> q;
    for(int i = 1; i <= n; i++) cin >> a[i];

    build(1, 1, n);

    while(q--){
        int type;
        cin >> type;
        if(type == 1){
            int l, r, x;
            cin >> l >> r >> x;
            upd(1, 1, n, l, r, x);
        }
        else{
            int l, r;
            cin >> l >> r;
            int ans = get(1, 1, n, l, r) % mod;
            cout << ans << el;
        }
    }

    return 0;
}
