#include<bits/stdc++.h>
using namespace std;

const int maxn = (int) 1e6 + 7;
long long sum[maxn], n, arr[maxn];
vector<int> ans;

void sieve(){
    for(int i = 1; i <= (int) 1e6; i++){
        for(int j = i; j <= (int) 1e6; j += i)
            sum[j] += i;
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    #define file "GHH"
    if(fopen(file".inp", "r")){
        freopen(file".inp", "r", stdin);
        freopen(file".out", "w", stdout);
    }

    sieve();

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> arr[i];
        if(arr[i]*2 <= sum[arr[i]]) ans.push_back(arr[i]);
    }

    cout << ans.size() << '\n';
    for(int elm:ans) cout << elm << '\n';

    return 0;
}
