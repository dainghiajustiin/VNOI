        int u, v; cin >> u >> v;
        adj[u].pb(v);
        adj[v].pb(u);
    }

    for(int i = 1; i <= numNode; i++) r[i] = i;

    dfs(1, 0);
    dd[1] = 1;

    cin >> numQuery;
    while(numQuery--){
        int u, v; cin >> u >> v;

        int p = lca(u, v);

        Checking(u, p);
        Checking(v, p);
    }

    int ans = 0;
    for(int i = 1; i <= numNode; i++)
        if(!dd[i]) ans++;

    cout << ans;

