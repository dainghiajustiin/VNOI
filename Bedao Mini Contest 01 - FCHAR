#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
int ans = inf;
string s;
int m;
int cnt[26];

bool check(){
    int ok = 0;
    for(int i = 0; i < 5; i++)
        ok += (cnt[i] >= m);
    return ok == 5;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> s;
    cin >> m;

    int j = 0;
    for(int i = 0; i < s.size(); i++){
        cnt[s[i] - 'a']++;
        while(check()){
            ans = min(ans, i - j + 1);
            cnt[s[j] - 'a']--;
            j++;
        }
    }

    cout << (ans == inf ? -1 : ans);

    return 0;
}
