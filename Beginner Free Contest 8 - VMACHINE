/// code

void solve(){
    ll n; cin >> n;
    vector<ll> get;

    while(n){
        ll a = n/2, b = n - a;
        if(b == a) b++;
        get.pb(b);
        n = a;
    }

    cout << get.size() << el;
    for(ll it:get) cout << it << ' ';
    cout << el;
}

