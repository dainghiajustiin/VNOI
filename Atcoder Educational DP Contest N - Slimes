#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
int dp[401][401];
int n, a[401];
int ps[401];

int get(int l, int r){
    return ps[r] - ps[l - 1];
}

int f(int i, int j){
    if(i >= j) return 0;

    if(dp[i][j] != 0) return dp[i][j];

    int res = inf;
    for(int k = i; k < j; k++){
        res = min(res, get(i, j) + f(i, k) + f(k +  1, j));
    }

    return dp[i][j] = res;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
