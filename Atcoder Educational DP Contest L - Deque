const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = 3003;
int dp[maxn][maxn];

int n, s = 0;
int a[maxn];

int get(int i, int j){
    if(i > j) return 0;
    if(dp[i][j] != 0) return dp[i][j];

    int op1 = a[i] + min(get(i + 1, j - 1), get(i + 2, j));
    int op2 = a[j] + min(get(i + 1, j - 1), get(i, j - 2));

    return dp[i][j] = max(op1, op2);
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
