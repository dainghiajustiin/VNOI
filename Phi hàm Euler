/// code
const int maxn = (int) 1e6 + 3;
bool dd[maxn];



void sieve(){
    dd[0] = dd[1] = 1;
    for(int i = 2; i*i < maxn; i++){
        if(!dd[i]){
            for(int j = i*i; j < maxn; j += i) dd[j] = 1;
        }
    }
}

void solve(){
    int n; cin >> n;
    int res = n;
    for(int i = 2; i*i <= n; i++){
        if(n % i == 0){
            res = res/i*(i - 1);
            while(n % i == 0) n /= i;
        }
    }

    if(!dd[n]) res = res/n*(n - 1);

    cout << res << el;
}

