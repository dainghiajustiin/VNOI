/// code(
const int maxn = (int) 1e5 + 3;

int n, m;
vector<int> adj[maxn];
bool dd[maxn];
int res1, res2;

int dfs(int u){
    int res = 1;
    dd[u] = 1;

    for(int v:adj[u]){
        if(!dd[v]){
            res += dfs(v);
        }
    }

    return res;
}

