#include<bits/stdc++.h>
using namespace std;

const int MAXN = (int) 1e5 + 7;
int n, d, a[MAXN], cnt[MAXN];
long long ans = 0;

void add(int& s, int v){
    s = (s + v) % d;
    if(s < 0) s += d;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cnt[0] = 1;
    cin >> n >> d;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        add(a[i], a[i-1]);
        ans += cnt[a[i]];
        cnt[a[i]] += 1;
    }
    cout << ans;

    return 0;
}
