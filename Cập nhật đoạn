#include<bits/stdc++.h>
using namespace std;

const int MAXN = (int) 2e5 + 7;
int n, q;
long long a[MAXN], add[MAXN];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> n >> q;
    for(int i = 1; i <= n; i++)
        cin >> a[i];
    while(q-->0){
        int l, r, x;
        cin >> l >> r >> x;
        add[l] += x;
        add[r+1] -= x;
    }
    for(int i = 1; i <= n; i++)
        add[i] += add[i-1];
    for(int i = 1; i <= n; i++)
        cout << a[i] + add[i] << ' ';

    return 0;
}
