using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 7;
int n;
bool dd[maxn];
int a[maxn];
int ans = 0;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        if(!dd[a[i]]){
            dd[a[i]] = 1;
            ans++;
        }
    }

    for(int i = 2; i <= (int) 1e5; i++){
        if(dd[i]) continue;
        int g = 0;
        for(int j = 2; j * i <= (int) 1e5; j++){
            if(dd[j*i]) g = __gcd(g, j*i);
        }
        ans += (g == i);
    }

    if(!dd[1]){
        int g = 0;
        for(int i = 1; i <= n; i++) g = __gcd(g, a[i]);
        ans += (g == 1);
    }

    cout << ans;

    return 0;
}
