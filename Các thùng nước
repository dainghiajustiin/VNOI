    for(int i = 1; i <= 100000; i++) r[i] = i;

    cin >> p;
    while(p--){
        int type, u, v;
        cin >> u >> v >> type;

        if(type == 1){
            Union(u, v);
        }
        else{
            u = Find(u);
            v = Find(v);

            cout << (u == v) << el;
        }
    }

    return 0;
}
