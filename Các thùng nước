/// code
const int maxn = (int) 1e5 + 3;
int r[maxn];
int p;

int Find(int u){
    if(u == r[u]) return u;
    return r[u] = Find(r[u]);
}

void Union(int u, int v){
    u = Find(u);
    v = Find(v);
    r[v] = u;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

