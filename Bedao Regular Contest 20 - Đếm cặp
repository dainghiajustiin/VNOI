/// code

void solve(){
    int n; cin >> n;
    int x = sqrt(n);
    if(n % 16 != 0 || x * x != n){
        cout << 0 << el;
        return;
    }
    int ans = 0;
    for(int a = 1; a*a <= x; a++){
        if(x % a == 0){
            int b = x/a;
            if(a % 2 == 0 && b % 2 == 0){
                if(a != b) ans += 2;
                else ans++;
            }
        }
    }

    cout << ans << el;
}

