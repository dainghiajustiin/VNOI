#include <bits/stdc++.h>

using namespace std;
int n, x, y;
int a[2001];

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    cin >> n >> x >> y;
    for(int i = 1; i <= n; i++) cin >> a[i];
    
    if(n == 1){
        int ans = abs(a[1] - y);
        cout << ans;
        return 0;
    }
    
    int ans = max(abs(a[n - 1] - a[n]), abs(a[n] - y));
    
    cout << ans;
    
    return 0;
}
