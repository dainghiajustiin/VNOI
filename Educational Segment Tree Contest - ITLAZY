#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
int n, q;
int a[maxn];
pii seg[maxn << 2];

void build(int id, int l, int r){
    if(l == r){
        seg[id].fi = a[l];
        return;
    }

    int m = l + r >> 1;

    build(id << 1, l , m);
    build(id << 1 | 1, m + 1, r);

    seg[id].fi = max(seg[id << 1].fi, seg[id << 1 | 1].fi);
}
void down(int id){
    int k = seg[id].se;
    seg[id].se = 0;

    seg[id << 1].fi += k;
    seg[id << 1].se += k;

    seg[id << 1 | 1].fi += k;
    seg[id << 1 | 1].se += k;
}
void upd(int id, int l, int r, int u, int v, int val){
    if(v < l || r < u) return;
    if(u <= l && r <= v){
        seg[id].fi += val;
        seg[id].se += val;
        return;
    }

    down(id);
    int m = l + r >> 1;

    upd(id << 1, l, m, u, v, val);
    upd(id << 1 | 1, m + 1, r, u, v, val);

    seg[id].fi = max(seg[id << 1].fi, seg[id << 1 | 1].fi);
}
int get(int id, int l, int r, int u, int v){
    if(v < l || r < u) return -inf;
    if(u <= l && r <= v) return seg[id].fi;

    down(id);
    int m = l + r >> 1;

    int it1 = get(id << 1, l, m, u, v);
    int it2 = get(id << 1 | 1, m + 1, r, u, v);

    return max(it1, it2);
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];

    build(1, 1, n);

    cin >> q;
    while(q--){
        int type; cin >> type;

        if(type == 1){
            int x, y, val; cin >> x >> y >> val;
            upd(1, 1, n, x, y, val);
        }
        else{
            int l, r; cin >> l >> r;
            int ans = get(1, 1, n, l, r);
            cout << ans << el;
        }
    }

    return 0;
}
