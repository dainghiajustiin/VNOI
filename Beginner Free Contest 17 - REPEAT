/// code
const int maxn = (int) 1e5 + 3;

int numNode, numQuery;
vector<int> adj[maxn];
int h[maxn];
bool dd[maxn];

void dfs(int u, int p){
    for(int v:adj[u]){
        if(v == p) continue;

        h[v] = h[u] + 1;
        dfs(v, u);
    }
}

