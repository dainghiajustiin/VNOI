    cin >> numNode;

    for(int i = 1; i <= numNode; i++){
        h[i] = -1;
        int x; cin >> x;
        
        if(x == i){
            dd[i] = 1;
        }
        else{
            adj[x].pb(i);
            adj[i].pb(x);
        }
    }

    for(int i = 1; i <= numNode; i++){
        if(dd[i]){
            h[i] = 1;
            dfs(i, 0);
        }
    }

    cin >> numQuery;
    
    while(numQuery--){
        int x; cin >> x;
        cout << h[x] << ' ';
    }
 
