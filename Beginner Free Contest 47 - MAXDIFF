#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 3e5 + 3;
int a[maxn];
int n;
int pre[maxn];
int suf[maxn];

void build1(){
    priority_queue<int, vector<int>, greater<int>> pq;
    int s = 0;
    for(int i = 1; i <= n; i++){
        s += a[i];
        pq.push(a[i]);
    } pre[n] = s;

    for(int i = n + 1; i <= 2*n; i++){
        s += a[i];
        pq.push(a[i]);

        int mi = pq.top(); pq.pop();
        s -= mi;

        pre[i] = s;
    }
}

void build2(){
    priority_queue<int> pq;
    int s = 0;
    for(int i = 3*n; i > 2*n; i--){
        s += a[i];
        pq.push(a[i]);
    } suf[2*n + 1] = s;

    for(int i = 2*n; i > n; i--){
        s += a[i];
        pq.push(a[i]);

        int ma = pq.top(); pq.pop();
        s -= ma;

        suf[i] = s;
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= 3*n; i++) cin >> a[i];

    build1();
    build2();

    int ans = -inf;

    for(int i = n; i <= 2*n; i++){
        ans = max(ans, pre[i] - suf[i + 1]);
    }

    cout << ans;

    return 0;
}
