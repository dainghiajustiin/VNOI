/// code
string s, t;
const int maxn = 3001;

int cnt[maxn][maxn];
pii last[maxn][maxn];
int ma = 0;

pii get;
string ans;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> s >> t;
    s = " " + s;
    t = " " + t;
    for(int i = 1; i < s.size(); i++){
        for(int j = 1; j < t.size(); j++){
            if(s[i] == t[j]) cnt[i][j] = cnt[i - 1][j - 1] + 1;
            else cnt[i][j] = max(cnt[i][j - 1], cnt[i - 1][j]);


        }
    }

    int n = (int)s.size() - 1, m = (int)t.size() - 1;
    while(n && m){
        if(s[n] == t[m]){
            ans.pb(s[n]);
            n--, m--;
        }
        else if(cnt[n - 1][m] > cnt[n][m - 1]) n--;
        else m--;
    }

    reverse(all(ans));
    cout << ans;

    return 0;
}
