#include<bits/stdc++.h>
using namespace std;

const int MAXN = (int) 1e5 + 7;

int n, q;
long long a[MAXN];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> n >> q;
    for(int i = 1; i <= n; i++)
        cin >> a[i], a[i] += a[i-1];
    for(;q-->0;){
        int l, r;
        cin >> l >> r;
        cout << a[r] - a[l-1] << '\n';
    }

    return 0;
}
