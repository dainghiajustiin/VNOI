#include<bits/stdc++.h>
using namespace std;

const int N = (int) 2e5 + 3;

int cntChild[N], nSize;
vector<int> adj[N];

void dfs(int u, int pre){
    cntChild[u] += 1;

    for(int v:adj[u]){
        if(v == pre) continue;

        dfs(v, u);
        cntChild[u] += cntChild[v];
    }
}

int findCentroid(int u, int pre){
    for(int v:adj[u]){
        if(v == pre) continue;

        if(cntChild[v] > nSize/2) return findCentroid(v, u);
    }

    return u;
}

