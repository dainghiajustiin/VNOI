/// code
void solve(){
    string s; cin >> s;
    int cnt = 0;
    stack<char> st;
    for(char c:s){
        if(c == '(') st.push(c);
        else if(c == ')'){
            if(st.size()){
                cnt++;
                st.pop();
            }
        }
    }
    cnt <<= 1;
    cout << cnt;
}

