/// code
const int maxn = (int) 2e5 + 3;
int cnt[23];
int n, a[maxn];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];

    ll ans = 0;

    for(int i = 1; i <= n; i++){
        if(i <= 6) cnt[a[i]%23]++;
        else{
            ans += cnt[a[i]%23];
            for(int j = 1; j <= 5; j++)
                if(a[i - j]%23 == a[i]%23) ans--;

            cnt[a[i]%23]++;
        }
    }

    cout << ans;

    return 0;
}
