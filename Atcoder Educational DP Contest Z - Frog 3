#include<bits/stdc++.h>
using namespace std;

#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 2e5 + 3;
int n;
ll dp[maxn], h[maxn], c;
int cur = 1, sz = 0;

struct line{
    ll a, b;
    line(ll a_ = 0, ll b_ = 0){
        a = a_;
        b = b_;
    }
};

line Lines[maxn];
double giao(line L1, line L2){
    return (1.0 * L1.b - L2.b) / (L2.a - L1.a);
}

void add(line L3){
    while(sz >= 2){
        line L2 = Lines[sz], L1 = Lines[sz - 1];
        if(giao(L1, L2) >= giao(L1, L3)){
            sz--;
        }
        else break;
    }

    Lines[++sz] = L3;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> c;
    for(int i = 1; i <= n; i++) cin >> h[i];

    add(line(-2 * h[1], h[1] * h[1]));
    for(int i = 2; i <= n; i++){
        if(cur > sz) cur = sz;
        while(cur + 1 <= sz && Lines[cur].a * h[i] + Lines[cur].b
              >= Lines[cur + 1].a * h[i] + Lines[cur + 1].b) cur++;
        dp[i] = Lines[cur].a*h[i] + Lines[cur].b + c + h[i]*h[i];
        add(line(-2 * h[i], dp[i] + h[i]*h[i]));
    }

    cout << dp[n];

    return 0;
}
