#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 5e4 + 3;
int n, q;
int a[maxn];
pii seg[maxn << 2];
int ma, mi;

void build(int id, int l, int r){
    if(l == r){
        seg[id].fi = seg[id].se = a[l];
        return;
    }

    int m = l + r >> 1;

    build(id << 1, l, m);
    build(id << 1 | 1, m + 1, r);

    seg[id].fi = max(seg[id << 1].fi, seg[id << 1 | 1].fi);
    seg[id].se = min(seg[id << 1].se, seg[id << 1 | 1].se);
}

void get(int id, int l, int r, int u, int v){
    if(v < l || r < u) return;
    if(u <= l && r <= v){
        ma = max(ma, seg[id].fi);
        mi = min(mi, seg[id].se);

        return;
    }

    int m = l + r >> 1;

    get(id << 1, l, m, u, v);
    get(id << 1 | 1, m + 1, r, u, v);
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> q;

    for(int i = 1; i <= n; i++) cin >> a[i];

    build(1, 1, n);

    while(q--){
        int l, r; cin >> l >> r;

        ma = -inf, mi = inf;
        get(1, 1, n, l, r);

        int ans = ma - mi;

        cout << ans << el;
    }

    return 0;
}
