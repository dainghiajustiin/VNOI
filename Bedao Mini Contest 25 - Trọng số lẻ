#define ll long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e6 + 3;
int a[maxn];
int cnt1, cnt2;
int n;
ll s = 0;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        if(a[i]&1) cnt1++;
        else cnt2++;
    }

    for(int i = 1; i <= n; i++){
        if(a[i]&1) s = (s + 1ll*a[i]*cnt2) % MOD;
        else s= (s + 1ll*a[i]*cnt1) % MOD;
    }

    cout << s;

    return 0;
}
