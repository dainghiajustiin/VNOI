#include<bits/stdc++.h>
using namespace std;

#define int long long
#define Mp make_pair
#define fi first
#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 1e5 + 3;
const int len = log2(maxn) + 1;

struct LCA{
    int pre;
    int mi, ma;

    LCA(){
        mi = inf;
        ma = -inf;
    }
} par[maxn][len];

int h[maxn];
vector<pii> vec[maxn];
int n, q;
int res_mi, res_ma;

void dfs(int u, int p){
    for(pii it:vec[u]){
        int v = it.se;
        if(v == p) continue;

        h[v] = h[u] + 1;
        par[v][0].pre = u;
        par[v][0].mi = par[v][0].ma = it.fi;

        for(int i = 1; i < len; i++){
            par[v][i].pre = par[par[v][i - 1].pre][i - 1].pre;
            par[v][i].mi = min(par[v][i - 1].mi, par[par[v][i - 1].pre][i - 1].mi);
            par[v][i].ma = max(par[v][i - 1].ma, par[par[v][i - 1].pre][i - 1].ma);
        }

        dfs(v, u);
    }
}

int lca(int u, int v){
    if(h[u] < h[v]) swap(u, v);

    int d = h[u] - h[v];
    for(int i = 0; (1 << i) <= d; i++){
        if((d >> i) & 1) u = par[u][i].pre;
    }

    if(u == v) return u;

    int lg = log2(h[u]);
    for(int i = lg; i > -1; i--){
        if(par[u][i].pre != par[v][i].pre){
            u = par[u][i].pre;
            v = par[v][i].pre;
        }
    }

    return par[u][0].pre;
}

void get(int child, int p){
    int d = h[child] - h[p];

    for(int i = 0; (1 << i) <= d; i++){
        if((d >> i) & 1){
            res_mi = min(res_mi, par[child][i].mi);
            res_ma = max(res_ma, par[child][i].ma);
            child = par[child][i].pre;
        }
    }
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i < n; i++){
        int u, v, w;
        cin >> u >> v >> w;

        vec[u].pb(Mp(w, v));
        vec[v].pb(Mp(w, u));
    }

    dfs(1, 0);

    cin >> q;
    while(q--){
        int u, v;
        cin >> u >> v;
        int T = lca(u, v);

        res_mi = inf;
        res_ma = -inf;

        get(u, T);
        get(v, T);

        cout << res_mi << ' ' << res_ma << el;
    }

    return 0;
}
