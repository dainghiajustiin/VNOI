using pii = pair<int,int>;

/// code
int n, m;
char a[53][53];

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n >> m;
    for(int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++) cin >> a[i][j];
    }

    int ans = 0;
    for(int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++){
            ans--;

            int s = 1;
            for(int k = i + 1; k <= n; k++){
                if(a[i][j] == a[k][j]) s *= 2;
            }
            ans += s;

            s = 1;
            for(int k = j + 1; k <= m; k++){
                if(a[i][j] == a[i][k]) s *= 2;
            }
            ans += s;
        }
    }

    cout << ans;

    return 0;
}
