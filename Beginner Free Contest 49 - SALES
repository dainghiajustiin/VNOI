/// code
const int maxn = (int) 1e5 + 7;
int n;
int a[maxn];
int ans = 0;

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];
    sort(a + 1, a + 1 + n);

    for(int i = 1; i <= n; i++){
        int j = i;
        while(a[i + 1] == a[j]) i++;

        int d = i - j + 1;

        if(d == 1){
            cout << -1;
            return 0;
        }

        if(d % 3 == 0) ans += d/3;
        else{
            if(d % 3 == 1){
                ans += 2; d -= 4;
                ans += d/3;
            }
            else{
                ans += 1; d -= 2;
                ans += d/3;
            }
        }
    }

    cout << ans;

    return 0;
}
