#define se second
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()

const int MOD = (int) 1e9 + 7;
const int inf = (int) 1e18 + 7;
using pii = pair<int,int>;

/// code
const int maxn = (int) 3e4 + 5;
int n;
int a[maxn];
int seg[maxn << 2];
vector<int> nenso;

int get(int id, int l, int r, int pos){
    if(pos < l) return 0;
    if(pos >= r) return seg[id];

    int m = l + r >> 1;

    int it1 = get(id << 1, l, m, pos);
    int it2 = get(id << 1 | 1, m + 1, r, pos);

    return max(it1, it2);
}

void upd(int id, int l, int r, int pos, int val){
    if(pos < l || r < pos) return;
    if(l == r){
        seg[id] = max(seg[id], val);
        return;
    }

    int m = l + r >> 1;

    upd(id << 1, l, m, pos, val);
    upd(id << 1 | 1, m + 1, r, pos, val);

    seg[id] = max(seg[id << 1], seg[id << 1 | 1]);
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    cin >> n;
    for(int i = 1; i <= n; i++){
        cin >> a[i];
        nenso.pb(a[i]);
    }

    sort(all(nenso));

    for(int i = 1; i <= n; i++){
        int pivot = lower_bound(all(nenso), a[i]) - nenso.begin() + 1;
        int res = get(1, 1, n, pivot - 1);
        upd(1, 1, n, pivot, res + 1);
    }

    int ans = seg[1];
    cout << ans;

    return 0;
}
