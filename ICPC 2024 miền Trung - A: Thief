#include<bits/stdc++.h>
using namespace std;

#define fi first
#define se second
#define ll long long
#define pb push_back
#define el '\n'
#define all(x) x.begin(), x.end()
#define Mp make_pair
#define lg2(x) 31 - __builtin_clz(x)
using pii = pair<int,int>;
const int MOD = (int) 1e9 + 7;
const ll inf = (ll) 1e18 + 7;
using ull = unsigned long long;

/// code
const int maxn = (int) 1e5 + 3;
ll dp[maxn];
int N, W, H, Sum = 0;
int w[111];
int v[111];

signed main(){
    cin.tie(0)->ios_base::sync_with_stdio(0);

//    #define task ""
//    freopen(task".inp", "r", stdin);
//    freopen(task".out", "w", stdout);

    if(fopen("buon.inp", "r")){
        freopen("buon.inp", "r", stdin);
        freopen("buon.out", "w", stdout);
    }

    cin >> N >> W >> H;

    for(int i = 1; i <= N; i++){
        cin >> w[i] >> v[i];
        Sum += v[i];
    }

    ll ans = 0;

    for(int i = 0; i <= N; i++){
        if(w[i] > H) continue;
        for(int j = 1; j <= Sum; j++) dp[j] = MOD;
        ll res = v[i];

        for(int j = 1; j <= N; j++){
            if(j == i) continue;
            for(int maxValue = Sum; maxValue >= v[j]; maxValue--){
                dp[maxValue] = min(dp[maxValue], dp[maxValue - v[j]] + w[j]);
            }
        }

        for(int j = Sum; j > 0; j--){
            if(dp[j] <= W){
                res += j;
                break;
            }
        }

        ans = max(ans, res);
    }

    cout << ans;

    return 0;
}   /// Justiin
