#include<bits/stdc++.h>
using namespace std;

#define ll long long

const int N = 505;

ll n, x;
ll first[N], Time[N];

ll check(ll MID){
    ll res = 0;
    for(int i = 1; i <= n; i++){
        if(first[i] > MID) continue;
        ll sufTime = MID - first[i];
        res += 1 + sufTime/Time[i];
    }

    return (res >= x);
}

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

//    #define TASK ""
//    if(fopen(TASK".inp", "r")){
//        freopen(TASK".inp", "r", stdin);
//        freopen(TASK".out", "w", stdout);
//        freopen(TASK".ans", "w", stdout);
//    }

    cin >> n >> x;
    for(int i = 1; i <= n; i++) cin >> first[i] >> Time[i];

    ll L = 1, R = (ll) 1e18;
    ll ans = (ll) 1e18;

    while(L <= R){
        ll MID = L + R >> 1;

        if(check(MID)){
            R = MID - 1;
            ans = MID;
        }
        else L = MID + 1;
    }

    cout << ans;

    return 0;
}
