#include<bits/stdc++.h>
using namespace std;

const int MAXN = 50005;
const int INF = 1000000009;

struct Node{
    long long left = 0, right = 0, sum = 0, maxSum = -INF;
} IT[MAXN << 2];

int n, q, a[MAXN];

Node get(int id, int l, int r, int u, int v){
    if(v < l || r < u){
        Node res;
        res.left = res.right = res.sum = res.maxSum = -INF;
        return res;
    }

    if(u <= l && r <= v) return IT[id];

    int mid = (l + r) >> 1;
    Node it1 = get(id << 1, l, mid, u, v);
    Node it2 = get(id << 1 | 1, mid + 1, r, u, v);
    Node res;
    res.left = max({it1.left, it1.sum + it2.left, it1.sum + it2.sum});
    res.right = max({it2.right, it1.right + it2.sum, it1.sum + it2.sum});
    res.sum = it1.sum + it2.sum;
    res.maxSum = max({it1.right + it2.left, it1.maxSum, it2.maxSum});

    return res;
}

void build(int id, int l, int r){
    if(l == r){
        IT[id].left = IT[id].right = IT[id].sum = IT[id].maxSum = a[l];
        return;
    }

    int mid = (l + r) >> 1;

    build(id << 1, l, mid);
    build(id << 1 | 1, mid + 1, r);

    Node it1 = IT[id << 1];
    Node it2 = IT[id << 1 | 1];

    IT[id].left = max({it1.left, it1.sum + it2.left, it1.sum + it2.sum});
    IT[id].right = max({it2.right, it1.right + it2.sum, it1.sum + it2.sum});
    IT[id].sum = it1.sum + it2.sum;
    IT[id].maxSum = max({it1.right + it2.left, it1.maxSum, it2.maxSum});
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);

    cin >> n;
    for(int i = 1; i <= n; i++) cin >> a[i];
    build(1, 1, n);
    cin >> q;
    while(q-->0){
        int x, y;
        cin >> x >> y;
        cout << get(1, 1, n, x, y).maxSum << '\n';
    }

    return 0;
}
